{
  "rules": {
    "globalUsers": {
      ".indexOn": ["name", "nameLower", "role"],
      ".read": true,
      ".write": true
    },

    "driver_positions": {
      ".read": true,
      ".write": true
    },

    "fleets": {
      "$fleetId": {
        ".read": true,
        ".write": true
      }
    },

    "applicants": {
      ".read": true,
      ".write": true
    },

    "veraz_reports": {
      ".read": true,
      ".write": true
    },

    "global_traffic_alerts": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp", "status"]
    },

    "community_posts": {
      ".read": true,
      ".write": true
    },

    "sos_alerts": {
      ".read": true,
      ".write": true
    },

    "gps_tracker": {
      ".read": true,
      ".write": true
    },

    "app_installations": {
      ".read": true,
      ".write": true
    },

    "fcm_tokens": {
      ".read": true,
      ".write": true
    }
  }
}
